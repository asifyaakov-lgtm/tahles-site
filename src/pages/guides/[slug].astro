---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide, allGuides: guides },
  }));
}

const { guide, allGuides } = Astro.props;
const { Content, headings } = await guide.render();
const { title, day, promise, description, featuredImage, featuredImageAlt, summary, sample } = guide.data;

const related = (
  guide.data.relatedGuides
    ? guide.data.relatedGuides
        .map((slug) => allGuides.find((g) => g.slug === slug))
        .filter((g): g is (typeof allGuides)[number] => Boolean(g))
    : allGuides
        .filter((g) => g.slug !== guide.slug)
        .sort((a, b) => a.data.day - b.data.day)
).slice(0, 4);
---

<BaseLayout title={title} description={description} image={featuredImage}>
  <section class="guide-hero">
    <div class="container">
      <span class="badge">יום {day} מתוך 30</span>
      {sample && <span class="badge" style="margin-inline-start: 8px;">מדריך לדוגמה</span>}
      <h1 style="margin-top: 16px;">{title}</h1>
    </div>
  </section>

  <div class="container">
    {sample && (
      <div class="draft-banner">
        זהו מדריך לדוגמה שמראה איך התבנית עובדת מקצה לקצה. אפשר להשתמש בו כבסיס למדריכים 2-30.
      </div>
    )}

    {featuredImage && (
      <img class="guide-featured" src={featuredImage} alt={featuredImageAlt || title} width="1600" height="900" />
    )}

    <p class="guide-promise">{promise}</p>

    <div class="guide-layout">
      <div class="guide-main">
        <TableOfContents headings={headings} />

        <article class="prose">
          <Content />
        </article>

        <section class="section" style="padding-block: 32px 0;">
          <h2>סיכום</h2>
          <p style="color: var(--text-dim);">{summary}</p>
        </section>

        <div class="next-step-block">
          <h3>רוצים עוד כאלה?</h3>
          <p style="color: var(--text-dim);">הצטרפו לקבוצת הוואטסאפ לעדכונים על מדריכים חדשים.</p>
          <a href={SITE.whatsappGroupUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            הצטרפות לקבוצת הוואטסאפ
          </a>
        </div>

        <EmailSignup idSuffix="guide-main" />

        <div style="margin-top: 56px;">
          <RelatedGuides guides={related} />
        </div>
      </div>

      <aside class="guide-sidebar">
        <EmailSignup
          idSuffix="guide-sidebar"
          title="לא לפספס מדריך"
          subtitle="מדריך חדש ישר למייל, בלי ספאם."
        />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .guide-sidebar {
      display: none;
    }
  }
</style>
