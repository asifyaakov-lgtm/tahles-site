---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import FollowBlock from '../../components/FollowBlock.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import ConsultButton from '../../components/ConsultButton.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide, allGuides: guides },
  }));
}

const { guide, allGuides } = Astro.props;
const { Content, headings } = await guide.render();
const { title, promise, description, featuredImage, featuredImageAlt, summary, sample, category, publishDate } = guide.data;

const byNewest = (a: (typeof allGuides)[number], b: (typeof allGuides)[number]) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
const others = allGuides.filter((g) => g.slug !== guide.slug).sort(byNewest);
const related = (
  guide.data.relatedGuides
    ? guide.data.relatedGuides
        .map((slug) => allGuides.find((g) => g.slug === slug))
        .filter((g): g is (typeof allGuides)[number] => Boolean(g))
    : [...others.filter((g) => category && g.data.category === category), ...others.filter((g) => !category || g.data.category !== category)]
).slice(0, 4);

// Article structured data. Image falls back to the site-wide og-default.jpg, same as <meta og:image>.
const imageUrl = new URL(featuredImage ?? '/og-default.jpg', SITE.domain).toString();
const pageUrl = new URL(`/guides/${guide.slug}`, SITE.domain).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: [imageUrl],
  datePublished: publishDate.toISOString(),
  dateModified: publishDate.toISOString(),
  inLanguage: 'he',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: { '@type': 'Person', name: 'אסיף יעקב', url: SITE.domain },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  ...(category ? { articleSection: category } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={featuredImage}
  type="article"
  publishedTime={publishDate}
  jsonLd={jsonLd}
>
  <section class="guide-hero">
    <div class="container">
      {category && <span class="badge">{category}</span>}
      {sample && <span class="badge" style="margin-inline-start: 8px;">מדריך לדוגמה</span>}
      <h1 style="margin-top: 16px;">{title}</h1>
    </div>
  </section>

  <div class="container">
    {sample && (
      <div class="draft-banner">
        זהו מדריך לדוגמה שמראה איך התבנית עובדת מקצה לקצה. אפשר להשתמש בו כבסיס לכל מדריך חדש.
      </div>
    )}

    {featuredImage && (
      <img class="guide-featured" src={featuredImage} alt={featuredImageAlt || title} width="1600" height="900" />
    )}

    <p class="guide-promise">{promise}</p>

    <div class="guide-layout">
      <div class="guide-main">
        <TableOfContents headings={headings} />

        <article class="prose">
          <Content />
        </article>

        <section class="section" style="padding-block: 32px 0;">
          <h2>סיכום</h2>
          <p style="color: var(--text-dim);">{summary}</p>
        </section>

        <FollowBlock />

        {SITE.emailSignupAction.trim() && <EmailSignup idSuffix="guide-main" />}

        <ConsultButton context={title} />

        <div style="margin-top: 56px;">
          <RelatedGuides guides={related} />
        </div>
      </div>
    </div>
  </div>
  <WhatsAppFloat context={title} />
</BaseLayout>
