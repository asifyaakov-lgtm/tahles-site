---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../../lib/guides';
import { GUIDE_CATEGORIES } from '../../config/site';

const allGuides = (await getCollection('guides', ({ data }) => isLive(data))).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
// Only offer chips for categories that actually have a published guide.
const categories = GUIDE_CATEGORIES.filter((c) => allGuides.some((g) => g.data.category === c));
---

<BaseLayout
  title="כל המדריכים"
  description="מדריכי AI פרקטיים לבעלי עסקים בישראל - כל יום כלי אחד שלוקח את העסק צעד קדימה, בלי ז'רגון, בחינם."
>
  <section class="section" style="padding-top: 56px;">
    <div class="container">
      <div class="section-heading">
        <h1>כל המדריכים</h1>
        <p>כל יום כלי אחד שלוקח את העסק שלך צעד קדימה, עם מדריך חינם.</p>
      </div>

      {allGuides.length === 0 ? (
        <EmptyState />
      ) : (
        <>
          {categories.length > 0 && (
            <div class="filter-chips" role="group" aria-label="סינון לפי קטגוריה" data-filter-chips hidden>
              <button type="button" class="filter-chip" data-filter="" aria-pressed="true">הכל</button>
              {categories.map((c) => (
                <button type="button" class="filter-chip" data-filter={c} aria-pressed="false">{c}</button>
              ))}
            </div>
          )}
          <div class="card-grid" data-guide-grid>
            {allGuides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: chips are hidden until JS runs, so no-JS visitors just see every guide.
  const chips = document.querySelector<HTMLElement>('[data-filter-chips]');
  const grid = document.querySelector<HTMLElement>('[data-guide-grid]');
  if (chips && grid) {
    chips.hidden = false;
    chips.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
      if (!btn) return;
      const value = btn.dataset.filter ?? '';
      chips.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((b) => {
        b.setAttribute('aria-pressed', String(b === btn));
      });
      grid.querySelectorAll<HTMLElement>('.guide-card').forEach((card) => {
        card.hidden = value !== '' && card.dataset.category !== value;
      });
    });
  }
</script>
