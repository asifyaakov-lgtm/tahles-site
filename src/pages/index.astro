---
import BaseLayout from '../layouts/BaseLayout.astro';
import WavyLines from '../components/WavyLines.astro';
import GuideCard from '../components/GuideCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import EmptyState from '../components/EmptyState.astro';
import ConsultButton from '../components/ConsultButton.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config/site';

const allGuides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const latest = allGuides.slice(0, 6);
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="hero glow-backdrop">
    <WavyLines />
    <div class="container">
      <span class="badge">בינה מלאכותית לבעלי עסקים</span>
      <h1>
        <span class="gradient-text tagline-lines">
          {SITE.taglineLines.map((line) => (
            <span class="tagline-line">{line}</span>
          ))}
        </span>
      </h1>
      <p class="secondary-line">{SITE.secondaryLine}</p>
      <p class="lead">{SITE.ongoingLine}. {SITE.promiseLine}</p>
      <div class="actions">
        <a href="/guides" class="btn btn-primary">לכל המדריכים</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class={`signup-block about-block ${SITE.photo ? 'has-photo' : ''}`}>
        {SITE.photo && (
          <img class="about-photo" src={SITE.photo} alt={SITE.photoAlt} width="400" height="400" loading="lazy" />
        )}
        <div class="about-text">
          <h3>{SITE.whoIAm}</h3>
          <ConsultButton />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>המדריכים האחרונים</h2>
        <p>כל מדריך: מה לעשות, איך, ועם איזה פרומפט בדיוק.</p>
      </div>
      {latest.length > 0 ? (
        <div class="card-grid">
          {latest.map((guide) => (
            <GuideCard guide={guide} />
          ))}
        </div>
      ) : (
        <EmptyState />
      )}
      {allGuides.length > latest.length && (
        <p style="text-align:center; margin-top: 28px;">
          <a href="/guides" class="btn btn-outline">לכל המדריכים</a>
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EmailSignup />
    </div>
  </section>
</BaseLayout>
