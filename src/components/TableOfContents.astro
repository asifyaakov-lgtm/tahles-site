---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
// Only show top-level guide sections (h2) to keep the TOC short and scannable.
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 0 && (
  <details class="toc" open>
    <summary>תוכן העניינים</summary>
    <ol>
      {items.map((h) => (
        <li>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}
