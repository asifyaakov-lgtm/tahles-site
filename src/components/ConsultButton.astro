---
import { SITE, whatsappUrl } from '../config/site';

interface Props {
  /** Guide title: pre-fills the WhatsApp message so the source guide is known. */
  context?: string;
}
const { context } = Astro.props;

const url = context ? whatsappUrl(context) : SITE.consultUrl.trim();
const external = /^https?:\/\//.test(url);
---

{url && (
  <div class="consult-cta">
    <a
      href={url}
      class="btn btn-primary btn-consult"
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
    >
      {SITE.consultLabel}
    </a>
    <p class="consult-sub">עונה אישית בוואטסאפ, בלי התחייבות ובלי עלות.</p>
  </div>
)}
