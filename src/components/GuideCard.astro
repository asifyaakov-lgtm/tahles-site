---
import type { CollectionEntry } from 'astro:content';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { title, promise, sample, category } = guide.data;
---

<a href={`/guides/${guide.slug}`} class="guide-card" data-category={category ?? ''}>
  <span class="card-badges">
    {category && <span class="category-badge">{category}</span>}
    {sample && <span class="sample-badge">מדריך לדוגמה</span>}
  </span>
  <h3>{title}</h3>
  <p>{promise}</p>
</a>
