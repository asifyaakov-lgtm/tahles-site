---
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand" style="margin-bottom: 10px;">
          <span class="dot"></span>
          <span>תכל'ס AI</span>
        </div>
        <p style="max-width: 340px; font-size: 0.92rem;">
          {SITE.secondaryLine} {SITE.promiseLine}
        </p>
      </div>
      <div>
        <SocialLinks />
        <p style="margin: 14px 0 0; font-size: 0.92rem;">
          <a href={`mailto:${SITE.contactEmail}`} dir="ltr" class="footer-email">{SITE.contactEmail}</a>
        </p>
      </div>
    </div>
    <div class="footer-legal">
      <span>© {year} תכל'ס AI. כל הזכויות שמורות.</span>
    </div>
  </div>
</footer>
