---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'בית' },
  { href: '/guides', label: 'מדריכים' },
  { href: '/tools', label: 'טבלת כלים' },
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <span class="dot"></span>
      <span>תכל'ס AI</span>
    </a>
    <nav>
      <ul class="main-nav">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
