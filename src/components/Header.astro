---
import { SITE } from '../config/site';
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'בית' },
  { href: '/guides', label: 'מדריכים' },
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <span class="dot"></span>
      <span>תכל'ס AI</span>
    </a>
    <nav>
      <ul class="main-nav">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={(link.href === '/' ? pathname === '/' : pathname.startsWith(link.href)) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav-consult-item">
          <a href={SITE.consultUrl} class="nav-consult" target="_blank" rel="noopener">ייעוץ חינם</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
